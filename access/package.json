{
  "name": "dsh-im-omni-access",
  "version": "0.1.0",
  "private": true,
  "description": "Team access for the dsh-im-omni inbox: sign in to the team service, grant each member their channel numbers, approve privileged changes, and read the audit trail.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
